{
  "name": "metal-menagerie",
  "version": "1.0.0",
  "private": true,
  "description": "A small online shop for handmade metal statues: catalog, cart, card payments, shipping, inventory and an admin dashboard.",
  "main": "server.js",
  "scripts": {
    "prestart": "node -e \"if(!require('fs').existsSync('node_modules/express')){console.log('[prestart] installing dependencies');require('child_process').execSync('npm install --omit=dev --no-audit --no-fund',{stdio:'inherit'})}\"",
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server.js",
    "test": "node --disable-warning=ExperimentalWarning test.js"
  },
  "engines": {
    "node": ">=22.13 <25"
  },
  "dependencies": {
    "cookie-session": "^2.1.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.1",
    "libsql": "^0.5.29",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "stripe": "^17.4.0"
  }
}
