<%- include('partials/head', { title: 'Shop' }) %>

<div class="wrap section">
  <h1>The collection</h1>
  <p class="muted" style="margin-bottom:40px;max-width:60ch">
    <%= products.length %> pieces, each made once. Prices include nothing but the piece;
    shipping is confirmed with your order, before you pay.
  </p>

  <div class="grid">
    <% products.forEach(function (p) { %>
      <%- include('partials/card', { p: p }) %>
    <% }) %>
  </div>

  <% if (products.length === 0) { %>
    <div class="empty">Nothing listed yet.</div>
  <% } %>
</div>

<%- include('partials/foot') %>
