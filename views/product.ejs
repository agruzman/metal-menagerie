<%- include('partials/head', { title: product.name }) %>

<div class="wrap">
  <section class="product">
    <div>
      <div class="shot">
        <img id="mainShot" src="<%= product.image || '/uploads/group.jpg' %>" alt="<%= product.name %>">
      </div>
      <% if (product.gallery && product.gallery.length) { %>
        <div class="gallery">
          <button type="button" class="on" data-src="<%= product.image %>"><img src="<%= thumb(product.image) %>" alt=""></button>
          <% product.gallery.forEach(function (g) { %>
            <button type="button" data-src="<%= g %>"><img src="<%= thumb(g) %>" alt="Another view of <%= product.name %>"></button>
          <% }) %>
        </div>
      <% } %>
    </div>

    <div>
      <div class="eyebrow">Handmade · one of a kind</div>
      <h1><%= product.name %></h1>
      <p class="muted" style="margin-top:-6px"><%= product.subtitle %></p>
      <div class="price-big"><%= money(product.price_cents) %></div>

      <p><%= product.description %></p>

      <% if (product.stock > 0) { %>
        <form method="post" action="/cart/add" style="display:flex;gap:12px;align-items:center;margin-top:26px;flex-wrap:wrap">
          <input type="hidden" name="product_id" value="<%= product.id %>">
          <input type="hidden" name="qty" value="1">
          <button class="btn" type="submit">Order this piece</button>
          <span class="small muted">Only one exists. No payment until we confirm it is yours.</span>
        </form>
      <% } else { %>
        <p class="notice bad" style="margin-top:26px">
          This one has found a home. Write to <a href="mailto:<%= settings.contact_email %>"><%= settings.contact_email %></a>
          if you would like something in the same spirit made for you.
        </p>
      <% } %>

      <div class="spec">
        <dl>
          <% if (product.materials) { %><dt>Made from</dt><dd><%= product.materials %></dd><% } %>
          <% if (product.dimensions) { %><dt>Size</dt><dd><%= product.dimensions %></dd><% } %>
          <% if (product.weight_grams) { %><dt>Weight</dt><dd><%= product.weight_grams %> g</dd><% } %>
          <dt>Made by</dt><dd><a href="/genka">Genka</a>, by hand, in Israel</dd>
          <dt>Shipping</dt><dd>Boxed in foam, tracked and insured, to Europe, the USA, the Emirates and Israel. <a href="/policies">Rates</a></dd>
        </dl>
      </div>
    </div>
  </section>

  <% if (others.length) { %>
    <section class="section">
      <h2>Also in the workshop</h2>
      <div class="grid" style="margin-top:26px">
        <% others.forEach(function (p) { %>
          <%- include('partials/card', { p: p }) %>
        <% }) %>
      </div>
    </section>
  <% } %>
</div>

<script>
  document.querySelectorAll('.gallery button').forEach(function (b) {
    b.addEventListener('click', function () {
      document.getElementById('mainShot').src = b.dataset.src;
      document.querySelectorAll('.gallery button').forEach(function (x) { x.classList.remove('on'); });
      b.classList.add('on');
    });
  });
</script>

<%- include('partials/foot') %>
