<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Shopkeeper · <%= settings.store_name %></title>
<link rel="stylesheet" href="/css/style.css">
<meta name="robots" content="noindex">
</head>
<body class="admin">
  <div class="login-box">
    <div class="panel">
      <div class="eyebrow">Shopkeeper</div>
      <h2 style="margin-bottom:20px"><%= settings.store_name %></h2>
      <% if (error) { %><div class="notice bad"><%= error %></div><% } %>
      <form method="post" action="/admin/login">
        <div class="field">
          <label>Password</label>
          <input type="password" name="password" autofocus required>
          <div class="hint">Set as ADMIN_PASSWORD in your .env file.</div>
        </div>
        <button class="btn" type="submit" style="width:100%">Enter</button>
      </form>
    </div>
    <p class="center small"><a href="/">← back to the shop</a></p>
  </div>
</body>
</html>
