<a class="card" href="/product/<%= p.slug %>">
  <div class="shot">
    <% if (p.stock === 0) { %><span class="tag sold">Sold</span>
    <% } else { %><span class="tag">One of a kind</span><% } %>
    <img src="<%= thumb(p.image) %>" alt="<%= p.name %>" loading="lazy">
  </div>
  <h3><%= p.name %></h3>
  <div class="sub"><%= p.subtitle %></div>
  <div class="price"><%= money(p.price_cents) %></div>
</a>
