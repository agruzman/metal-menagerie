# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in your own values.
# The .env file holds your secrets. Never share it or put it on GitHub.
# ---------------------------------------------------------------------------

# The password you type to get into the admin dashboard at /admin
ADMIN_PASSWORD=change-this-password

# A long random string used to sign login/cart cookies. Any gibberish works.
SESSION_SECRET=change-this-to-a-long-random-string

# The public address of the shop. Locally leave as is.
# When you go live put your real domain, e.g. https://metalmenagerie.com
BASE_URL=http://localhost:3000

# Port the server listens on
PORT=3000

# ---------------------------------------------------------------------------
# STRIPE - handles the credit cards. Get these at https://dashboard.stripe.com
# Leave them empty and the shop runs in DEMO mode: orders go through without
# any real payment, so you can try everything before signing up.
# Keys starting with sk_test_ / pk_test_ are the sandbox. Nothing is charged.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Created when you add a webhook endpoint in the Stripe dashboard (see README)
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# EMAIL (optional). Used to send the buyer a receipt and to notify you of a
# new order. Leave empty and emails are just printed in the terminal instead.
# For Gmail: host=smtp.gmail.com, port=465, secure, and use an "App Password".
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ---------------------------------------------------------------------------
# HOSTED DATABASE (only needed once the shop lives on a server).
# Free hosts wipe the server's disk on every restart, so the database must
# live elsewhere. Turso (turso.tech) is hosted SQLite with a free plan:
#   turso db create metal-menagerie
#   turso db show metal-menagerie --url        -> TURSO_DATABASE_URL
#   turso db tokens create metal-menagerie     -> TURSO_AUTH_TOKEN
# Leave empty on your laptop and a local file data/shop.db is used instead.
# ---------------------------------------------------------------------------
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# If you host on a server WITH a persistent disk instead, point the local
# database at it (otherwise ignore):
# SHOP_DATA_DIR=/var/data/shop
